FROM ubuntu:24.04

ARG GO_VERSION=1.25.0

ENV DEBIAN_FRONTEND=noninteractive \
    GOPATH=/go \
    GOMODCACHE=/go/pkg/mod \
    GOCACHE=/root/.cache/go-build \
    PATH=/usr/local/go/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Prepare cache directories
RUN mkdir -p /var/cache/apt/archives /var/lib/apt/lists /go/pkg/mod /root/.cache/go-build

# Minimal runtime deps for fetching Go and resolving VCS modules
RUN apt-get update && \
    apt-get install -y --no-install-recommends gettext libcurl4-openssl-dev curl ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# Install Go toolchain
RUN curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz" -o /tmp/go.tgz && \
    rm -rf /usr/local/go && tar -C /usr/local -xzf /tmp/go.tgz && rm -f /tmp/go.tgz

# Persist caches when running with bind mounts
VOLUME ["/var/cache/apt/archives", "/var/lib/apt/lists", "/go/pkg/mod", "/root/.cache/go-build"]

WORKDIR /workspace

# Default command: optionally prefetch APT packages and warm Go caches for all modules under /workspace
CMD ["bash", "-lc", "set -e; if [ -n \"${PKGS:-}\" ]; then apt-get update; apt-get install -y --reinstall --download-only --no-install-recommends ${PKGS}; else echo 'NOTE: PKGS is empty – skipping APT prefetch.'; fi; echo \"==> go version: $(go version)\"; echo \"==> GOMODCACHE: $(go env GOMODCACHE)\"; echo \"==> GOCACHE:    $(go env GOCACHE)\"; mods=$(find /workspace -type f -name go.mod -not -path '*/vendor/*' | sort); if [ -z \"$mods\" ]; then echo 'NOTE: No go.mod found under /workspace – skipping Go cache warm.'; exit 0; fi; echo \"$mods\" | while read -r m; do dir=$(dirname \"$m\"); echo \"==> Warming module: ${dir#/workspace/}\"; ( cd \"$dir\" && go mod download ); ( cd \"$dir\" && CGO_ENABLED=0 go build ./... ) || true; done; num_mod_files=$(find \"$GOMODCACHE\" -type f | wc -l || true); num_go_cache_files=$(find \"$GOCACHE\" -type f | wc -l || true); echo \"==> GOMODCACHE files: ${num_mod_files}\"; echo \"==> GOCACHE files:    ${num_go_cache_files}\"; num_deb_files=$(find /var/cache/apt/archives -name '*.deb' | wc -l || true); echo \"==> APT .deb files:   ${num_deb_files}\";"] 